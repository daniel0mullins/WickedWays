{
  "name": "wickedways",
  "version": "0.0.1",
  "description": "Wicked Ways game engine",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include='src/**'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "checks": "npm run lint && npm run typecheck && npm run test",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "type-fest": "5.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "author": "",
  "license": "ISC"
}
