{
  "name": "wickedways",
  "version": "0.0.1",
  "description": "Wicked Ways game engine",
  "main": "index.js",
  "packageManager": "pnpm@9.15.6",
  "exports": {
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include='src/**'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "checks": "pnpm run lint && pnpm run typecheck && pnpm -r run typecheck && pnpm run test",
    "build": "tsc -p tsconfig.build.json",
    "docs:api": "typedoc",
    "docs:dev": "pnpm run docs:api && vitepress dev docs-site",
    "docs:build": "pnpm run docs:api && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site"
  },
  "dependencies": {
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "type-fest": "5.6.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "author": "",
  "license": "ISC"
}
