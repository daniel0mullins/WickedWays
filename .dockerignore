# Keep the Docker build context small and reproducible. Anything needed to
# install + build the workspace (package.json files, lockfile, source, configs)
# is NOT listed here; everything generated or host-local is.
.git
.github
**/node_modules
**/dist
coverage
**/coverage
test-results
playwright-report
docs-site/.vitepress/cache
docs-site/.vitepress/dist
landing/vendor
**/*.log
.DS_Store

# Never bake host-local secrets into an image layer.
.env

# Rust build artifacts. `target/` alone is >1GB; everything the image needs is
# compiled inside the builder stage — shipping a host-built copy would let a
# stale artifact pass locally while a clean checkout (Coolify) fails.
**/target
crates/wickedways-wasm/pkg
crates/wickedways-wasm/pkg-node
crates/wickedways-wasm/pkg-web

# Host-local tooling scratch.
.claude
.codegraph
.superpowers
.vscode
