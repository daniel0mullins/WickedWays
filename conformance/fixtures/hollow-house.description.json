  "rooms": [
    {
      "name": "Foyer",
      "description": "The entrance hall of the Hollow House. Dust sheets shroud the furniture; the front door has locked itself behind you."
    },
    {
      "name": "Cellar",
      "description": "A low brick cellar, black as a throat. Water seeps somewhere unseen.",
      "dark": true
    },
    {
      "name": "Hall",
      "description": "A long central hall. Portraits watch from the walls, their eyes scratched out.",
      "spawnModifier": 1
    },
    {
      "name": "Kitchen",
      "description": "A cold scullery. Copper pots hang in rows; one still sways.",
      "spawnModifier": 1
    },
    {
      "name": "Parlor",
      "description": "A receiving parlor gone to mildew. A piano sits with its lid nailed shut.",
      "spawnModifier": 1
    },
    {
      "name": "Landing",
      "description": "The upstairs landing. Two doors face you — one to the west, one leading further up — and a nursery stands open to the east.",
      "spawnModifier": 1
    },
    {
      "name": "Study",
      "description": "A cramped study, papers everywhere, as if someone left mid-sentence."
    },
    {
      "name": "Nursery",
      "description": "A child's nursery. A rocking horse moves, very slightly, on its own.",
      "dark": true
    },
    {
      "name": "Attic",
      "description": "The attic, under the bare ribs of the roof. This is where the journal ends."
    }
  ],
