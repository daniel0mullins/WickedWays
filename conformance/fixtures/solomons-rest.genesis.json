    "winConditions": [
      {
        "key": "survived-to-daybreak",
        "narration": {
          "text": "Gray light crests the yews, and the birdsong is suddenly, absurdly ordinary. Down the rows a lantern gutters out, a spade is shouldered, and the Sexton goes below without a backward glance. The lychgate stands open. Whoever is still on their feet walks out of Solomon's Rest — and nobody ever takes the dare again."
        }
      }
    ]
