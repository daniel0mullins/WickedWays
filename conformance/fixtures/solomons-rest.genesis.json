    "loseConditions": [
      {
        "key": "the-flock-is-taken",
        "narration": {
          "text": "The last of you goes down, and the yard falls quiet. Unhurried footsteps. The scrape of a spade. The Sexton works until the sky pales, and by morning Solomon's Rest has four new mounds, unmarked, dug together — because even now, he keeps you together."
        }
      }
    ],
