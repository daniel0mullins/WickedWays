{
  "aliases": {},
  "behaviors": {
    "scene/threshold-draft": {
      "family": "scene",
      "script": {
        "canPlay": {
          "expr": {
            "default": false,
            "field": "seen",
            "kind": "stateGet"
          },
          "kind": "not"
        },
        "onEnter": [
          {
            "cond": {
              "kind": "bin",
              "left": {
                "kind": "round"
              },
              "op": "eq",
              "right": {
                "kind": "lit",
                "value": 0.0
              }
            },
            "kind": "guard"
          },
          {
            "cond": {
              "expr": {
                "default": false,
                "field": "revealed",
                "kind": "stateGet"
              },
              "kind": "not"
            },
            "kind": "when",
            "then": [
              {
                "effect": {
                  "kind": "cue",
                  "text": {
                    "kind": "lit",
                    "value": "A cold draft stirs the dust of the threshold."
                  }
                },
                "kind": "emit"
              },
              {
                "field": "revealed",
                "kind": "setState",
                "value": {
                  "kind": "lit",
                  "value": true
                }
              }
            ]
          },
          {
            "field": "seen",
            "kind": "setState",
            "value": {
              "kind": "lit",
              "value": true
            }
          }
        ]
      }
    }
  },
  "formations": {},
  "items": {},
  "recipes": {}
}
